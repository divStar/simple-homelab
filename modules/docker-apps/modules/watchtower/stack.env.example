MANAGEMENT_IP=10.0.5.100
WATCHTOWER_LOG_FORMAT=JSON
WATCHTOWER_LOG_LEVEL=info
WATCHTOWER_NO_STARTUP_MESSAGE=true
WATCHTOWER_CLEANUP=true
WATCHTOWER_INCLUDE_RESTARTING=true
WATCHTOWER_INCLUDE_STOPPED=true
WATCHTOWER_POLL_INTERVAL=28800
WATCHTOWER_HTTP_API_UPDATE=true
WATCHTOWER_HTTP_API_TOKEN=<watchtower-http-api-token>
WATCHTOWER_HTTP_API_METRICS=true
WATCHTOWER_HTTP_API_PERIODIC_POLLS=true
WATCHTOWER_NOTIFICATIONS=email
WATCHTOWER_NOTIFICATION_EMAIL_FROM=watchtower@example.com
WATCHTOWER_NOTIFICATION_EMAIL_FROM_NAME=[Example] Watchtower
WATCHTOWER_NOTIFICATION_EMAIL_TO=admin@example.com
WATCHTOWER_NOTIFICATION_EMAIL_SERVER=smtp.example.com
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT=587
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_USER=watchtower@example.com
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=<smtp-app-password>
WATCHTOWER_NOTIFICATION_EMAIL_DELAY=2
