BASE_DOMAIN=example.com
APP_HOME_URL=https://grist.${BASE_DOMAIN}
GRIST_DEFAULT_EMAIL=<admin_email>
GRIST_FORCE_LOGIN=true
GRIST_SESSION_SECRET=<grist_session_secret>
# GRIST_SINGLE_ORG intentionally unset -> multi-org mode (URLs include /o/<orgslug>/).
GRIST_SANDBOX_FLAVOR=gvisor
REDIS_URL=redis://grist-redis:6379
# Database (TypeORM)
TYPEORM_TYPE=postgres
TYPEORM_HOST=grist-db
TYPEORM_PORT=5432
TYPEORM_USERNAME=grist
TYPEORM_PASSWORD=<grist_db_password>
TYPEORM_DATABASE=grist
POSTGRES_USER=grist
POSTGRES_PASSWORD=<grist_db_password>
POSTGRES_DB=grist
# OIDC setup
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
GRIST_OIDC_IDP_ISSUER=https://zitadel.${BASE_DOMAIN}
GRIST_OIDC_IDP_CLIENT_ID=<oidc_client_id>
GRIST_OIDC_IDP_CLIENT_SECRET=<oidc_client_secret>
GRIST_OIDC_IDP_SCOPES=openid email profile
GRIST_OIDC_SP_HOST=https://grist.${BASE_DOMAIN}
GRIST_OIDC_IDP_ENABLED_PROTECTIONS=PKCE,STATE
