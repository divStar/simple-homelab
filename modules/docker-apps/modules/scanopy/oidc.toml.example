[[oidc_providers]]
name = "Zitadel"
slug = "zitadel"
issuer_url = "https://zitadel.example.domain"
client_id = "<scanopy-zitadel-client-id>"
client_secret = "<scanopy-zitadel-client-secret>"
# Zitadel puts the project ID into every ID token's audience alongside the client ID - without
# listing it here, login fails with "`<project-id>` is not a trusted audience".
trusted_audiences = ["<scanopy-zitadel-project-id>"]
