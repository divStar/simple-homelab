proxmox_node_name = "sanctum"

ssh = {
  host = "192.168.1.5"
  user = "root"
}

proxmox = {
  name     = "sanctum"
  host     = "sanctum.my.world"
  ssh_user = "root"
  ssh_key  = "~/.ssh/id_rsa"
  username = "root@pam"
  password = "some-password"
  insecure = false
}

bridges = [
  {
    name       = "vmbr1"
    ports      = ["enp1s0f0", "enp1s0f1"]
    vlan_aware = true
    comment    = "LAN bridge"
  }
]

vlan_interfaces = [
  {
    name    = "vmbr1.99"
    address = "192.168.99.10/24"
    comment = "Host presence on some VLAN"
  }
]

response_routes = [
  {
    interface      = "vmbr1.99"
    source_address = "192.168.99.10"
    gateway        = "192.168.99.1"
    table_id       = 10
    table_name     = "example"
    priority       = 100
  }
]

configuration_files = [
  {
    source      = "./files/.vimrc"
    destination = "/root/.vimrc"
  }
]

packages = [
  "git",
  "vim",
  "linux-cpupower",
  "shellcheck"
]

no_subscription = true

scripts = {
  directory = "/root/tofu-scripts"
  items = [
    {
      name           = "pve-mod-nag-screen.sh"
      url            = "https://raw.githubusercontent.com/Meliox/PVE-mods/refs/heads/main/pve-mod-nag-screen.sh"
      apply_params   = "install"
      destroy_params = "uninstall"
      # run_on_destroy defaults to true if not specified
    }
  ]
}

storage_pools = [
  "storage-pool"
]

storage_directories = {
  "assets" = {
    path    = "/mnt/storage/assets"
    content = "backup,iso,vztmpl,rootdir,snippets,import,images"
  }
  "vms" = {
    path    = "/mnt/storage/vms"
    content = "images,rootdir"
  }
}

nic_link_advertise = [
  {
    interface = "enp1s0f0"
    modes     = ["100baseT/Full", "1000baseT/Full", "2500baseT/Full", "5000baseT/Full", "10000baseT/Full"]
  }
]

directory_mappings = [
  {
    id      = "backups-storage"
    path    = "/mnt/storage/backups"
    comment = "Backup storage"
  },
  {
    id      = "documents-storage"
    path    = "/mnt/storage/documents"
    comment = "Document storage"
  }
  {
    id      = "music-storage"
    path    = "/mnt/storage/music"
    comment = "Music storage"
  },
  {
    id      = "pictures-storage"
    path    = "/mnt/storage/pictures"
    comment = "Picture storage"
  },
  {
    id      = "video-storage"
    path    = "/mnt/storage/video"
    comment = "Video storage"
  }
]